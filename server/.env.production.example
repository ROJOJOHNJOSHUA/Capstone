APP_ENV=production
APP_DEBUG=false
DB_HOST=your-vps-mysql-host
DB_PORT=3306
DB_NAME=your-production-database
DB_USER=your-production-database-user
DB_PASS=your-production-database-password
CORS_ORIGIN=https://holyfamilyparish.vercel.app
SESSION_LIFETIME=86400
SESSION_SECURE=true
SESSION_SAMESITE=None

# TextBee SMS Configuration
TEXTBEE_API_KEY=your-textbee-api-key
TEXTBEE_DEVICE_ID=your-textbee-device-id
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
